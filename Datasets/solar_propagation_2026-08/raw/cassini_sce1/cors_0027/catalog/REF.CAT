PDS_VERSION_ID                  = PDS3
RECORD_TYPE                     = STREAM

LABEL_REVISION_NOTE             = "
                2002-10-17 CASSINI: DConner Initial;
                2003-09-29 CASSINI: DConner Revision 1;
                2004-03-03 CN:      SLAdams, general fixes detailed below;

01) added BOUCHERETAL1994 in place of ITRF1993, per EB e-mail 10dec03;
02) TYLERETAL1981, changed Jupiteros to Jupiter's, per DS e-mail 14oct03;
03) changed 2nd TYLERETAL1981 to TYLERETAL1981B as currently in catalog;
04) change 2nd occurance of WOO1975 to WOO1975B;
05) added ESTABROOKETAL1995, per SLA validation;
06) added WOO1993, per DS comments about SLA validation;
07) added JPLD-5564, per SLA validation;
08) in PAETZOLDETAL1991B, changed 'Part II' to 'Part 2', as now in catalog;
"



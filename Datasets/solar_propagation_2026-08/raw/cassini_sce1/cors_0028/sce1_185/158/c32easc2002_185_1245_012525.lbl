  END_OBJECT                   = COLUMN
  OBJECT                       = COLUMN
    NAME                         = "DN VALUE"
    COLUMN_NUMBER                = 3
    START_BYTE                   = 22
    BYTES                        = 12
    DATA_TYPE                    = CHARACTER
    DESCRIPTION                  = "
          Data number, the raw value reported by the sensor
          or other data source.  The DN VALUE is provided as
          a character string enclosed in double quotes since
          different channels report integers, floats, and
          ASCII strings.  See CHANNEL TYPE for more format
          information."
  END_OBJECT                   = COLUMN
  OBJECT                       = COLUMN
    NAME                         = "EU VALUE"
    COLUMN_NUMBER                = 4
    START_BYTE                   = 37
    BYTES                        = 12
    DATA_TYPE                    = CHARACTER
    DESCRIPTION                  = "

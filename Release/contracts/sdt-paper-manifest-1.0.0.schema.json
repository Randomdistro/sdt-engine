{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spatialdisplacementtheory.com/contracts/sdt-paper-manifest-1.0.0.schema.json",
  "title": "SDT public paper manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "file",
    "title",
    "domain",
    "status",
    "theory_steps",
    "equations",
    "claims",
    "terms",
    "references",
    "sections",
    "cross_references"
  ],
  "properties": {
    "schema": { "const": "sdt-paper-manifest-1.0.0" },
    "id": { "type": "string", "pattern": "^paper-[a-z0-9-]+$" },
    "file": { "type": "string", "pattern": "^paper-[a-z0-9-]+\\.html$" },
    "title": { "type": "string", "minLength": 8 },
    "domain": { "type": "string", "minLength": 2 },
    "status": { "type": "string", "minLength": 2 },
    "theory_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^L(?:[0-9]|1[0-9]|20)$" },
      "uniqueItems": true
    },
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provenanceItem" }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/provenanceItem" }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^term-[a-z0-9-]+$" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "doi", "url", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^ref-[a-z0-9-]+$" },
          "type": { "enum": ["repo", "external"] },
          "path": { "type": "string" },
          "doi": { "type": "string" },
          "url": { "type": "string" },
          "text": { "type": "string", "minLength": 8 }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "cross_references": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "provenanceItem": {
      "type": "object",
      "required": ["id", "status", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
